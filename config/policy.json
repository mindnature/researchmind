{
  "version": "0.5",
  "default_lens_family": "scientific_judgment",
  "lens_families": {
    "scientific_judgment": {
      "episode_types": [
        "scientific_decision",
        "problem_framing",
        "method_choice",
        "anomaly_response",
        "theory_revision"
      ]
    },
    "methodological_stance": {
      "episode_types": [
        "methodological_stance",
        "paradigm_shift_advocacy",
        "theory_revision",
        "research_program_strategy"
      ]
    },
    "research_strategy": {
      "episode_types": [
        "research_program_strategy",
        "paradigm_shift_advocacy"
      ]
    }
  },
  "excluded_episode_types": [
    "career_decision",
    "institution_building",
    "field_outcome"
